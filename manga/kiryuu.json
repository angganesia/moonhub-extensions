{
  "metadata": {
    "id": "kiryuu",
    "name": "Kiryuu",
    "baseUrl": "https://v7.kiryuu.to",
    "version": "1.0.4",
    "type": "manga",
    "lang": "id",
    "isNsfw": false
  },
  "endpoints": {
    "latest": "/",
    "latestPage": "/",
    "search": "/",
    "filter": "/",
    "optionList": "/"
  },
  "selectors": {
    "latest": {
      "item": "",
      "titleAttr": "",
      "titleFallback": "",
      "hrefAttr": "",
      "coverAttr": "",
      "excludeKeyword": ""
    },
    "search": {
      "method": "POST",
      "ajaxUrl": "/wp-admin/admin-ajax.php",
      "nonceSelector": "form[hx-post*='admin-ajax.php']",
      "payload": {
        "query": "{query}"
      },
      "item": "#searchResults a[href]",
      "titleAttr": "h3",
      "coverAttr": "img",
      "link": "href",
      "synopsisAttr": "p"
    },
    "filter": {
      "item": "",
      "titleAttr": "",
      "coverAttr": "",
      "link": ""
    },
    "optionList": {
      "groups": [
        {
          "key": "",
          "title": "",
          "item": "",
          "labelAttr": "",
          "valueAttr": ""
        }
      ]
    },
    "detail": {
      "json": {
        "item": "script[type='application/ld+json']",
        "type": "Book",
        "type1": "ComicSeries"
      },
      "title": "[itemprop='name']",
      "cover": "[itemprop='image'] img",
      "synopsis": "[data-show='false'][itemprop='description']",
      "genres": "[itemprop='genre']",
      "status": "",
      "released": "",
      "type": "",
      "author": "",
      "episodes": "#chapter-list > div[data-chapter-number]",
      "epLink": "a",
      "epNum": "span",
      "epTitle": ".flex.flex-row.gap-1.font-medium.text-base span",
      "epDate": "time"
    },
    "stream": {
      "defaultIframe": "section[data-image-data='1'] img",
      "mirrorOption": "",
      "downloadLink": ""
    }
  }
}
