{
  "metadata": {
    "id": "anoboybe",
    "name": "AnoboyBe",
    "baseUrl": "https://anoboy.be",
    "version": "1.1.1",
    "type": "anime",
    "lang": "id",
    "isNsfw": false
  },
  "endpoints": {
    "latest": "/",
    "latestPage": "/page/{page}/",
    "search": "/page/{page}/?s={query}",
    "filter": "/anime/?page={page}&{query}",
    "optionList": "/anime/"
  },
  "selectors": {
    "latest": {
      "item": ".home_index a, .content .home_index div.sitemap",
      "titleAttr": "title",
      "titleFallback": ".jjudul",
      "hrefAttr": "href",
      "coverAttr": "img",
      "excludeKeyword": "/category/"
    },
    "search": {
      "item": "article.bs",
      "titleAttr": "h2[itemprop=\"headline\"]",
      "coverAttr": "img.ts-post-image",
      "link": ".bsx a"
    },
    "filter": {
      "item": "article.bs",
      "titleAttr": "h2[itemprop=\"headline\"]",
      "coverAttr": "img.ts-post-image",
      "link": ".bsx a"
    },
    "optionList": {
      "item": ".filter-dropdown select option, .genres-list li a, .filter-group input",
      "labelAttr": "text",
      "valueAttr": "value"
    },
    "detail": {
      "title": ".entry-title, h1.entry-title",
      "cover": ".thumbook .thumb img, .bigcontent img",
      "synopsis": ".bixbox.synp .entry-content p",
      "genres": ".info-content .genxed a",
      "status": ".spe span",
      "episodes": ".eplister ul li a",
      "epNum": ".epl-num",
      "epTitle": ".epl-title",
      "epDate": ".epl-date"
    },
    "stream": {
      "defaultIframe": "#pembed iframe",
      "mirrorOption": ".mirror option",
      "downloadLink": ".soraurlx a"
    }
  }
}
