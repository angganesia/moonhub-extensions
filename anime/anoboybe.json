{
  "metadata": {
    "id": "anoboybe",
    "name": "AnoboyBe",
    "baseUrl": "https://anoboy.be",
    "version": "1.2.3",
    "type": "anime",
    "lang": "id",
    "isNsfw": false
  },
  "endpoints": {
    "latest": "/",
    "latestPage": "/page/{page}/",
    "search": "/page/{page}/?s={query}",
    "filter": "/anime/?page={page}&{query}",
    "optionList": "/anime/"
  },
  "selectors": {
    "latest": {
      "item": ".home_index a, .content .home_index div.sitemap",
      "titleAttr": "title",
      "titleFallback": ".jjudul",
      "hrefAttr": "href",
      "coverAttr": "img",
      "excludeKeyword": "/category/"
    },
    "search": {
      "item": "article.bs",
      "titleAttr": "h2[itemprop=\"headline\"]",
      "coverAttr": "img.ts-post-image",
      "link": ".bsx a"
    },
    "filter": {
      "item": "article.bs",
      "titleAttr": "h2[itemprop=\"headline\"]",
      "coverAttr": "img.ts-post-image",
      "link": ".bsx a"
    },
    "optionList": {
      "groups": [
        {
          "key": "genre%5B%5D",
          "title": "Genre",
          "item": ".filter.dropdown:has(input[name='genre[]']) ul.dropdown-menu li",
          "labelAttr": "text",
          "valueAttr": "value"
        },
        {
          "key": "season%5B%5D",
          "title": "Season",
          "item": ".filter.dropdown:has(input[name='season[]']) ul.dropdown-menu li",
          "labelAttr": "text",
          "valueAttr": "value"
        },
        {
          "key": "studio%5B%5D",
          "title": "Studio",
          "item": ".filter.dropdown:has(input[name='studio[]']) ul.dropdown-menu li",
          "labelAttr": "text",
          "valueAttr": "value"
        },
        {
          "key": "status",
          "title": "Status",
          "item": ".filter.dropdown:has(input[name='status']) ul.dropdown-menu li",
          "labelAttr": "text",
          "valueAttr": "value"
        },
        {
          "key": "type",
          "title": "Type",
          "item": ".filter.dropdown:has(input[name='type']) ul.dropdown-menu li",
          "labelAttr": "text",
          "valueAttr": "value"
        },
        {
          "key": "sub",
          "title": "Sub",
          "item": ".filter.dropdown:has(input[name='sub']) ul.dropdown-menu li",
          "labelAttr": "text",
          "valueAttr": "value"
        },
        {
          "key": "order",
          "title": "Order by",
          "item": ".filter.dropdown:has(input[name='order']) ul.dropdown-menu li",
          "labelAttr": "text",
          "valueAttr": "value"
        }
      ]
    },
    "detail": {
      "title": ".entry-title, h1.entry-title",
      "cover": ".thumbook .thumb img, .bigcontent img",
      "synopsis": ".bixbox.synp .entry-content p",
      "genres": ".info-content .genxed a",
      "status": ".spe span",
      "episodes": ".eplister ul li a",
      "epNum": ".epl-num",
      "epTitle": ".epl-title",
      "epDate": ".epl-date"
    },
    "stream": {
      "defaultIframe": "#pembed iframe",
      "mirrorOption": ".mirror option",
      "downloadLink": ".soraurlx a"
    }
  }
}
